#!/usr/bin/env sh
# Validates the commit message with conventional-pre-commit (configured in .pre-commit-config.yaml).
set -e
if ! command -v pre-commit >/dev/null 2>&1; then
  echo "pre-commit not installed. Run scripts/setup.sh (installs it with uv)." >&2
  exit 1
fi
exec pre-commit run --hook-stage commit-msg --commit-msg-filename "$1"
